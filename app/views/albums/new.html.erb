<div class="min-h-screen flex justify-center py-12 px-6">

  <div class="w-full max-w-md">

    <h2 class="text-3xl font-extralight tracking-wide text-gray-700 text-center">
      新しいアルバム
    </h2>


    <%= form_with model: @album, local: true, class: "mt-10" do |f| %>

      <% if @album.errors.any? %>
        <div class="mb-6 rounded-xl bg-red-50 border border-red-200 p-4">
          <p class="text-sm font-medium text-red-600">
            <%= @album.errors.count %>件のエラーが発生しました。
          </p>

          <ul class="mt-2 text-sm text-red-500 list-disc list-inside">
            <% @album.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mt-6">

        <%= f.label :title,
            class: "block text-sm text-gray-500 mb-2" do %>
          タイトル <span class="text-red-500">*</span>
        <% end %>

        <%= f.text_field :title,
            class: "w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-200" %>

      </div>

      <div class="mt-6">

        <%= f.label :description,
            "説明",
            class: "block text-sm text-gray-500 mb-2" %>

        <%= f.text_area :description,
            rows: 4,
            class: "w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-200" %>

      </div>

      <div class="mt-6">

        <%= f.label :started_on,
            class: "block text-sm text-gray-500 mb-2" do %>
          開始日 <span class="text-red-500">*</span>
        <% end %>

        <%= f.date_field :started_on,
            class: "w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-200" %>

      </div>

      <div class="mt-10 pt-8 border-t border-gray-200">
        <h3 class="text-lg font-medium text-gray-700 mb-6 text-center">最初の Before / After を登録</h3>

        <%= f.fields_for :album_records do |record_f| %>
          <div class="space-y-6 bg-gray-50/60 p-5 rounded-2xl border border-gray-100">

            <div>
              <%= record_f.label :title, "B/A タイトル（任意）", class: "block text-sm text-gray-600 mb-2" %>
              <%= record_f.text_field :title,
                  class: "w-full border border-gray-200 bg-white rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" %>
            </div>

            <div class="p-3 bg-white rounded-xl border border-gray-100">
              <p class="text-xs font-bold uppercase text-red-500 mb-3">Before</p>
              
              <div class="space-y-3">
                <div>
                  <%= record_f.label :before_date, "Before 撮影日", class: "block text-xs text-gray-500 mb-1" %>
                  <%= record_f.date_field :before_date,
                      class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-blue-300" %>
                </div>

                <div>
                  <%= record_f.label :before_image, "Before 写真", class: "block text-xs text-gray-500 mb-1" %>
                  <%= record_f.file_field :before_image,
                      accept: "image/*",
                      class: "w-full text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-full file:border-0 file:text-xs file:bg-red-50 file:text-red-500 hover:file:bg-red-100 cursor-pointer" %>
                </div>
              </div>
            </div>

            <div class="p-3 bg-white rounded-xl border border-gray-100">
              <p class="text-xs font-bold uppercase text-blue-500 mb-3">After</p>

              <div class="space-y-3">
                <div>
                  <%= record_f.label :after_date, "After 撮影日", class: "block text-xs text-gray-500 mb-1" %>
                  <%= record_f.date_field :after_date,
                      class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-blue-300" %>
                </div>

                <div>
                  <%= record_f.label :after_image, "After 写真", class: "block text-xs text-gray-500 mb-1" %>
                  <%= record_f.file_field :after_image,
                      accept: "image/*",
                      class: "w-full text-xs text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-full file:border-0 file:text-xs file:bg-blue-50 file:text-blue-500 hover:file:bg-blue-100 cursor-pointer" %>
                </div>
              </div>
            </div>

            <div>
              <%= record_f.label :memo, "メモ(任意)", class: "block text-sm text-gray-600 mb-2" %>
              <%= record_f.text_area :memo,
                  rows: 3,
                  placeholder: "変化や感想などを記録できます",
                  class: "w-full border border-gray-200 bg-white rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200" %>
            </div>

          </div>
        <% end %>
      </div>
     
      <div class="mt-10">

        <%= f.submit "アルバムを作成する",
            class: "w-full bg-blue-400 hover:bg-blue-500 text-white py-3 rounded-full transition duration-300" %>

      </div>

    <% end %>

  </div>

</div>