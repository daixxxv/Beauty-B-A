<div class="min-h-screen flex justify-center py-12 px-6">

  <div class="w-full max-w-md">

    <h2 class="text-3xl font-extralight tracking-wide text-gray-700 text-center">
      新しいアルバム
    </h2>


    <%= form_with model: @album, local: true, class: "mt-10" do |f| %>

      <% if @album.errors.any? %>
        <div class="mb-6 rounded-xl bg-red-50 border border-red-200 p-4">
          <p class="text-sm font-medium text-red-600">
            <%= @album.errors.count %>件のエラーが発生しました。
          </p>

          <ul class="mt-2 text-sm text-red-500 list-disc list-inside">
            <% @album.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mt-6">

        <%= f.label :title,
            class: "block text-sm text-gray-500 mb-2" do %>
          タイトル <span class="text-red-500">*</span>
        <% end %>

        <%= f.text_field :title,
            class: "w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-200" %>

      </div>

      <div class="mt-6">

        <%= f.label :description,
            "説明",
            class: "block text-sm text-gray-500 mb-2" %>

        <%= f.text_area :description,
            rows: 4,
            class: "w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-200" %>

      </div>

      <div class="mt-6">

        <%= f.label :started_on,
            class: "block text-sm text-gray-500 mb-2" do %>
          開始日 <span class="text-red-500">*</span>
        <% end %>

        <%= f.date_field :started_on,
            class: "w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-200" %>

      </div>

      <div class="mt-10">

        <%= f.submit "アルバムを作成する",
            class: "w-full bg-blue-400 hover:bg-blue-500 text-white py-3 rounded-full transition duration-300" %>

      </div>

    <% end %>

  </div>

</div>