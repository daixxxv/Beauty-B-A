<div class="max-w-6xl mx-auto px-6 py-12">

  <div class="relative flex items-center justify-center mb-10">
    <h1 class="text-3xl font-serif text-gray-500 text-center">
      My Albums
    </h1>

    <div class="absolute right-0">
      <%= link_to "＋ 新しいアルバム作成",
          new_album_path,
          class: "bg-blue-400 hover:bg-blue-500 text-white px-5 py-3 rounded-full transition duration-300" %>
    </div>
  </div>

  <% if @albums.any? %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
    <% @albums.each do |album| %>

      <%= link_to album_path(album), class: "border border-gray-200 rounded-2xl p-6 bg-white shadow-md transition duration-300 flex flex-col justify-between group hover:shadow-lg hover:-translate-y-1 transform" do %>

        <div class="mb-4">

          <h2 class="text-xl mb-4 text-gray-700 transition duration-300 group-hover:text-blue-400" %>
            <%= album.title %>
          </h2>

          <div class="grid grid-cols-2 gap-3 mb-4">

            <div>
              <p class="text-[10px] tracking-widest uppercase text-blue-500 font-bold mb-1">Before</p>

              <% if album.before_image.attached? %>
                <%= image_tag album.before_image, class: "w-full aspect-square object-cover rounded-xl" %>
              <% else %>
                <div class="w-full aspect-square bg-gray-100 rounded-xl flex items-center justify-center">
                  <span class="text-gray-400">No Image</span>
                </div>
              <% end %>
            </div>

            <div>
              <p class="text-[10px] tracking-widest uppercase text-blue-500 font-bold mb-1">After</p>
              <% if album.after_image.attached? %>
                <%= image_tag album.after_image, class: "w-full aspect-square object-cover rounded-xl" %>
              <% else %>
                <div class="w-full aspect-square bg-gray-100 rounded-xl flex items-center justify-center">
                  <span class="text-gray-400 text-xs">No Image</span>
                </div>
              <% end %>
            </div>

          </div>

        </div>

        <p class="mt-2 text-gray-500 text-sm line-clamp-2">
          <%= album.description %>
        </p>

        <p class="mt-4 pt-4 border-t border-gray-200 flex items-center justify-between text-xs text-gray-600">
          開始日：<%= album.started_on&.strftime('%Y/%m/%d') %>
        </p>

      <% end %>

    <% end %>

  <% else %>

    <div class="text-center py-20">
      <p class="text-gray-400">
        まだアルバムがありません
      </p>
    </div>

  <% end %>

</div>