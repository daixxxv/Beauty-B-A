<div class="max-w-4xl mx-auto px-6 py-12">

  <div class="flex items-center justify-between mb-10">
    <h1 class="text-3xl font-extralight text-gray-700">
      My Albums
    </h1>

    <%= link_to "＋ 新しいアルバム",
        new_album_path,
        class: "bg-blue-400 hover:bg-blue-500 text-white px-5 py-3 rounded-full transition duration-300" %>
  </div>

  <% if @albums.any? %>

    <% @albums.each do |album| %>

      <div class="border border-gray-200 rounded-2xl p-6 mb-6">

        <h2 class="text-xl">
          <%= link_to album.title,
            album_path(album),
            class: "text-gray-700 hover:text-blue-400 transition duration-300" %>
        </h2>

        <p class="mt-3 text-gray-500">
          <%= album.description %>
        </p>

        <p class="mt-4 text-sm text-gray-400">
          開始日：<%= album.started_on %>
        </p>

      </div>

    <% end %>

  <% else %>

    <div class="text-center py-20">
      <p class="text-gray-400">
        まだアルバムがありません
      </p>
    </div>

  <% end %>

</div>