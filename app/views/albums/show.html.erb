<div class="max-w-3xl mx-auto px-6 py-12">

  <div class="flex items-baseline justify-between gap-4">

    <div class="flex items-baseline gap-12 flex-wrap">

      <h1 class="text-4xl text-gray-700">
        <%= @album.title %>
      </h1>
      <p class="text-2xl text-gray-700">
      開始日：<%= @album.started_on&.strftime('%Y/%m/%d') %>
      </p>

    </div>

      <div class="flex gap-3">

        <%= link_to "アルバムを編集",
            edit_album_path(@album),
            class: "bg-blue-400 hover:bg-blue-500 text-white px-5 py-2 rounded-full transition duration-300 text-sm whitespace-nowrap" %>

      </div>

  </div>

  <p class="mt-6 text-gray-500 leading-8">
    <%= @album.description %>
  </p>

  <div class="mt-12">

    <h2 class="text-2xl font-light text-gray-700 mb-6">
      Before / After
    </h2>

    <div class="grid grid-cols-2 gap-6">

      <div class="border border-gray-200 rounded-2xl p-4">

        <p class="text-xs tracking-widest uppercase text-blue-500 mb-3 font-semibold">
          Before
        </p>

        <% if @album.before_image.attached? %>
          <%= image_tag @album.before_image, class: "w-full aspect-square object-cover rounded-xl" %>
        <% else %>
          <div class="aspect-square bg-gray-100 rounded-xl flex items-center justify-center text-gray-400 text-sm">
            No Image
          </div>
        <% end %>

      </div>


      <div class="border border-gray-200 rounded-2xl p-4">

        <p class="text-xs tracking-widest uppercase text-blue-500 mb-3">
          After
        </p>

        <% if @album.after_image.attached? %>
          <%= image_tag @album.after_image, class: "w-full aspect-square object-cover rounded-xl" %>
        <% else %>
          <div class="aspect-square bg-gray-100 rounded-xl flex items-center justify-center text-gray-400 text-sm">
            No Image
          </div>
        <% end %>

      </div>

    </div>

  </div>


  <hr class="my-12 border-gray-200">


  <h2 class="text-2xl font-light text-gray-700">
    経過記録
  </h2>


