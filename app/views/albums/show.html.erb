<div class="max-w-3xl mx-auto px-6 py-12">

  <div class="flex items-baseline justify-between gap-4">

    <div class="flex items-baseline gap-12 flex-wrap">

      <h1 class="text-4xl text-gray-700">
        <%= @album.title %>
      </h1>
      <p class="text-2xl text-gray-700">
      開始日：<%= @album.started_on&.strftime('%Y/%m/%d') %>
      </p>

    </div>

      <div class="flex gap-3">

        <%= link_to "アルバムを編集",
            edit_album_path(@album),
            class: "bg-blue-400 hover:bg-blue-500 text-white px-5 py-2 rounded-full transition duration-300 text-sm whitespace-nowrap" %>

      </div>

  </div>

  <p class="mt-6 text-gray-500 leading-8">
    <%= @album.description %>
  </p>

  <div class="mt-12">

    <h2 class="text-2xl font-serif text-gray-500 flex justify-center mb-6">
      Before / After 一覧
    </h2>

    <% if @album.album_records.any? %>
      <div class="space-y-8">
        <% @album.album_records.each_with_index do |record, index| %>
          <div class="border border-gray-200 rounded-2xl p-6 bg-white shadow-sm">
            
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-100">
              <h3 class="text-lg font-medium text-gray-700">
                <%= record.title.presence || "B/A Pair ##{index + 1}" %>
              </h3>
            </div>

            <div class="grid grid-cols-2 gap-6">

              <div class="bg-gray-50 rounded-xl p-3 border border-gray-100">
                <div class="grid grid-cols-3 items-center mb-3">
                  <p class="text-sm font-serif uppercase tracking-wider text-red-500 text-left">Before</p>
                  <p class="text-sm font-medium text-gray-500 text-center whitespace-nowrap"><%= record.before_date&.strftime('%Y/%m/%d') || "日付なし" %></p>
                  <div></div>
                </div>
                <% if record.before_image.attached? %>
                  <%= image_tag record.before_image, class: "w-full aspect-square object-cover rounded-lg shadow-inner" %>
                <% else %>
                  <div class="aspect-square bg-gray-100 rounded-lg flex items-center justify-center text-gray-400 text-xs">
                    No Image
                  </div>
                <% end %>
              </div>

              <div class="bg-blue-50/30 rounded-xl p-3 border border-blue-100/50">
                <div class="flex items-center justify-between mb-2">
                  <p class="text-sm font-serif uppercase tracking-wider text-blue-500 text-left">After</p>
                  <p class="text-sm font-medium text-gray-500 text-center whitespace-nowrap"><%= record.after_date&.strftime('%Y/%m/%d') || "日付なし" %></p>
                  <div></div>
                </div>
                <% if record.after_image.attached? %>
                  <%= image_tag record.after_image, class: "w-full aspect-square object-cover rounded-lg shadow-inner" %>
                <% else %>
                  <div class="aspect-square bg-gray-100 rounded-lg flex items-center justify-center text-gray-400 text-xs">
                    No Image
                  </div>
                <% end %>
              </div>

            </div>

          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 border-2 border-dashed border-gray-200 rounded-2xl bg-gray-50/50">
        <p class="text-gray-400">まだ Before / After が登録されていません</p>
      </div>
    <% end %>

  </div>

  <hr class="my-12 border-gray-200">

  <div class="flex justify-center gap-3 mt-12">

    <%= button_to "アルバムを削除",
      album_path(@album),
      method: :delete,
      class: "bg-red-500 hover:bg-red-600 text-white px-5 py-2 rounded-full transition duration-300 text-sm whitespace-nowrap",
      data: {
        turbo_confirm: "本当にこのアルバムを削除しますか？"
      } %>

  </div>

</div>