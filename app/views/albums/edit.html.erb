<div class="py-12 flex justify-center px-6 bg-white">
  <div class="w-full max-w-md">

    <div class="text-center mb-10">
      <h1 class="text-2xl font-serif tracking-wide text-blue-400">
        Beauty B/A
      </h1>

      <h2 class="mt-6 text-3xl font-light text-gray-700">
        アルバム編集
      </h2>
    </div>

    <%= form_with(model: @album, local: true) do |f| %>
      <% if @album.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-xs text-red-600">
          <p class="font-bold mb-1"><%= @album.errors.count %>件のエラーが発生しました：</p
          <ul class="list-disc list-inside">
            <% @album.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-6">
        <%= f.label :title, class: "block text-sm text-gray-600 mb-2" do %>
          タイトル <span class="text-red-500">*</span>
        <% end %>

        <%= f.text_field :title,
            autofocus: true,
            class: "w-full rounded-xl border border-gray-200 px-4 py-3 transition duration-200 hover:border-blue-300 focus:border-blue-400 focus:ring-1 focus:ring-blue-400/30 focus:outline-none" %>
      </div>

      <div class="mb-6">
        <%= f.label :description, "説明文", class: "block text-sm text-gray-600 mb-2" %>

        <%= f.text_area :description,
            rows: 4,
            class: "w-full rounded-xl border border-gray-200 px-4 py-3 transition duration-200 hover:border-blue-300 focus:border-blue-400 focus:ring-1 focus:ring-blue-400/30 focus:outline-none" %>
      </div>

      <div class="mb-8">
        <%= f.label :started_on, "開始日", class: "block text-sm text-gray-600 mb-2" %>

        <%= f.date_field :started_on,
            class: "w-full rounded-xl border border-gray-200 px-4 py-3 transition duration-200 hover:border-blue-300 focus:border-blue-400 focus:ring-1 focus:ring-blue-400/30 focus:outline-none text-gray-600" %>
      </div>

      <div class="mt-8 pt-8 border-t border-gray-200 mb-8">

        <% if @album.album_records.any? %>
          <div class="space-y-4">
            <% @album.album_records.each_with_index do |record, index| %>
              <div class="p-4 border border-gray-200 rounded-2xl bg-gray-50/50 hover:bg-gray-50 transition duration-200">
                
                <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                  <span class="font-medium text-gray-700 text-sm">
                    <%= record.title.presence || "B/A Pair ##{index + 1}" %>
                  </span>
                  <div class="flex items-center space-x-3 text-xs">
                    <%= link_to "編集", edit_album_album_record_path(@album, record), class: "text-blue-500 hover:underline font-medium" %>
                    <%= link_to "削除",
                      album_album_record_path(@album, record),
                      data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                      class: "text-red-400 hover:underline font-medium" %>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-3 mt-3">
                  
                  <div class="flex items-center space-x-2 bg-white p-2 rounded-xl border border-gray-100">
                    <% if record.before_image.attached? %>
                      <%= image_tag record.before_image, class: "w-10 h-10 object-cover rounded-lg flex-shrink-0" %>
                    <% else %>
                      <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center text-[10px] text-gray-400 flex-shrink-0">No Img</div>
                    <% end %>
                    <div class="overflow-hidden">
                      <p class="text-[10px] text-gray-400 font-bold uppercase">Before</p>
                      <p class="text-xs text-gray-600 truncate"><%= record.before_date&.strftime('%Y/%m/%d') || "日付未登録" %></p>
                    </div>
                  </div>

                  <div class="flex items-center space-x-2 bg-white p-2 rounded-xl border border-gray-100">
                    <% if record.after_image.attached? %>
                      <%= image_tag record.after_image, class: "w-10 h-10 object-cover rounded-lg flex-shrink-0" %>
                    <% else %>
                      <div class="w-10 h-10 bg-gray-100 rounded-lg flex items-center justify-center text-[10px] text-gray-400 flex-shrink-0">No Img</div>
                    <% end %>
                    <div class="overflow-hidden">
                      <p class="text-[10px] text-blue-500 font-bold uppercase">After</p>
                      <p class="text-xs text-gray-600 truncate"><%= record.after_date&.strftime('%Y/%m/%d') || "日付未登録" %></p>
                    </div>
                  </div>

                </div>

              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-400 text-center py-4">まだ B/A がありません</p>
        <% end %>

        <div class="flex justify-center mt-8 mb-6">
          <%= link_to "＋ 新しい B/A を追加", 
              new_album_album_record_path(@album), 
              class: "bg-blue-500 hover:bg-blue-600 text-white text-sm px-5 py-2.5 rounded-full transition duration-300 shadow-sm hover:shadow" %>
        </div>

      </div>

      <div>
        <%= f.submit "変更を保存する",
            class: "w-full bg-blue-500 hover:bg-blue-600 text-white rounded-full py-3 text-sm transition duration-300 cursor-pointer font-medium" %>
      </div>
    <% end %>

    <div class="mt-8 pt-6 border-t border-gray-100 text-center">
      <%= link_to "アルバム詳細に戻る", album_path(@album),
          class: "text-sm text-gray-500 hover:text-blue-300 underline transition duration-300" %>
    </div>

  </div>
</div>