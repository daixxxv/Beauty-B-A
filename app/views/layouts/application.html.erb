<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Beauty B/A" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-gray-800 antialiased">

    <header class="max-w-7xl mx-auto flex justify-between items-center px-6 py-6">

      <%= link_to root_path,
          class: "text-xl font-serif tracking-wide text-blue-400 hover:text-blue-400 transition duration-300" do %>
        Beauty B/A
      <% end %>

      <% if user_signed_in? %>

        <div class="flex items-center gap-6">

          <%= link_to "My Albums",
              #,
              class: "text-sm text-gray-500 hover:text-blue-400 transition duration-300" %>
              
          <%= link_to current_user.name,
              edit_user_registration_path,
              class: "text-sm text-gray-500 hover:text-blue-400 transition duration-300" %>

          <%= link_to "Logout",
              destroy_user_session_path,
              data: {
                turbo_method: :delete,
                turbo_confirm: "ログアウトしますか？"
              },
              class: "text-sm text-gray-500 hover:text-blue-400 transition duration-300" %>

        </div>

      <% else %>

        <%= link_to "ログイン",
            new_user_session_path,
            class: "text-sm text-gray-500 hover:text-blue-400 transition duration-300" %>

      <% end %>

    </header>

    <% flash.each do |type, message| %>
      <div class="max-w-3xl mx-auto px-6 mb-4">
        <div class="<%= type == 'notice' ? 'bg-green-50 border-green-200 text-green-700' : 'bg-rose-50 border-rose-200 text-rose-700' %> border rounded-lg px-4 py-3 text-sm">
          <%= message %>
        </div>
      </div>
    <% end %>

    <%= yield %>

  </body>
</html>
