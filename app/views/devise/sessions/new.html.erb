<div class="py-12 flex justify-center px-6 bg-white">

  <div class="w-full max-w-md">

   <div class="text-center mb-10">
      <h1 class="text-2xl font-serif tracking-wide text-blue-400">
        Beauty B/A
      </h1>

      <h2 class="mt-6 text-3xl font-light text-gray-700">
        ログイン
      </h2>

    </div>

    <%= form_for(resource,
          as: resource_name,
          url: session_path(resource_name)) do |f| %>

      <div class="mb-6">

        <%= f.label :email,
          class: "block text-sm text-gray-600 mb-2" do %>
          メールアドレス <span class="text-red-500">*</span>
        <% end %>

        <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          class: "w-full rounded-xl border border-gray-200 px-4 py-3 border-solid transition duration-200 hover:border-blue-400 focus:border-blue-400 focus:ring-blue-400 focus:outline-none" %>

      </div>

      <div class="mb-6">

        <%= f.label :password,
          class: "block text-sm text-gray-600 mb-2" do %>
          パスワード <span class="text-red-500">*</span>
        <% end %>

        <%= f.password_field :password,
          autocomplete: "current-password",
          class: "w-full rounded-xl border border-gray-200 px-4 py-3 border-solid transition duration-200 hover:border-blue-400 focus:border-blue-400 focus:ring-blue-400 focus:outline-none" %>

      </div>

      <% if devise_mapping.rememberable? %>

        <div class="flex items-center mb-8">

          <%= f.check_box :remember_me,
            class: "mr-2" %>

          <%= f.label :remember_me, "ログイン状態を維持する",
            class: "text-sm text-gray-600 cursor-pointer" %>

        </div>

      <% end %>

      <div class="actions">

        <%= f.submit "ログイン",
          class: "w-full bg-blue-500 hover:bg-blue-600 text-white rounded-full py-3 text-sm transition duration-300 cursor-pointer" %>

      </div>

    <% end %>

    <%# パスワードをお忘れの方 %>
    <% if devise_mapping.recoverable? %>
      <div class="mt-6 text-center">
        <%= link_to "パスワードをお忘れですか？", new_password_path(resource_name),
            class: "text-sm text-gray-600 hover:text-blue-300 underline transition" %>
      </div>
    <% end %>

    <%# アカウントをお持ちでない方（新規登録ボタン） %>
    <% if devise_mapping.registerable? %>
      <div class="mt-8 pt-6 border-t border-gray-100 text-center">
        <p class="text-xs text-gray-600 mb-3">まだアカウントをお持ちでない方</p>
        
        <%= link_to new_registration_path(resource_name),
            class: "block w-full py-3 px-4 border border-blue-400 text-blue-500 font-medium rounded-full hover:bg-blue-50 transition duration-300 text-center text-sm" do %>
          新規登録
        <% end %>
      </div>
    <% end %>

  </div>

</div>