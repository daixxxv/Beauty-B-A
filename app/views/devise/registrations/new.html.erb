<div class="py-12 flex justify-center px-6 bg-white">
  <div class="w-full max-w-md">

    <div class="text-center mb-10">
      <h1 class="text-2xl font-serif tracking-wide text-blue-400">
        Beauty B/A
      </h1>

      <h2 class="mt-6 text-3xl font-light text-gray-700">
        新規登録
      </h2>

    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-6">
        <%= f.label :name, class: "block text-sm font-medium text-gray-600 mb-2" do %>
          お名前 <span class="text-red-500">*</span>
        <% end %>

        <%= f.text_field :name,
          autofocus: true,
          class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-rose-300 focus:ring-rose-300" %>
      </div>

      <div class="mb-6">
        <%= f.label :email, class: "block text-sm font-medium text-gray-600 mb-2" do %>
          メールアドレス <span class="text-red-500">*</span>
        <% end %>

        <%= f.email_field :email,
          autocomplete: "email",
          class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-rose-300 focus:ring-rose-300" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, class: "block text-sm font-medium text-gray-600 mb-2" do %>
          パスワード <span class="text-red-500">*</span>
        <% end %>

        <% if @minimum_password_length %>
          <p class="text-xs text-gray-400 mb-2">
            <%= @minimum_password_length %>文字以上で入力してください
          </p>
        <% end %>

        <%= f.password_field :password,
          autocomplete: "new-password",
          class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-blue-300 focus:ring-blue-300" %>
      </div>

      <div class="mb-8">
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-600 mb-2" do %>
          パスワード（確認） <span class="text-red-500">*</span>
        <% end %>

        <%= f.password_field :password_confirmation,
          autocomplete: "new-password",
          class: "w-full rounded-xl border border-gray-200 px-4 py-3 focus:border-blue-300 focus:ring-blue-300" %>
      </div>

      <div class="mt-8">
        <%= f.submit "アカウントを作成",
          class: "w-full bg-blue-500 hover:bg-blue-500 text-white py-3 rounded-full transition duration-300 cursor-pointer" %>
      </div>

    <% end %>

    <div class="mt-8 pt-6 border-t border-gray-100 text-center">
      <p class="text-xs text-gray-400 mb-3">すでにアカウントをお持ちの方</p>
      
      <%= link_to new_session_path(resource_name), class: "block w-full py-3 px-4 border border-blue-300 text-blue-500 font-medium rounded-full hover:bg-blue-50 transition duration-300 text-center text-sm" do %>
        ログイン
      <% end %>
    </div>

  </div>
</div>