<div class="min-h-screen flex justify-center py-12 px-6">
  <div class="w-full max-w-md">

    <h2 class="text-3xl font-normal tracking-wide text-gray-500 text-center mb-4">
      B/A の編集
    </h2>

    <%= form_with(model: [@album, @album_record], local: true, multipart: true) do |f| %>

      <div class="mt-6">
        <%= f.label :title, "B/Aタイトル（任意）", class: "block text-sm text-gray-500 mb-2" %>
        <%= f.text_field :title, placeholder: "B/A 1", class: "w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
      </div>

      <%# Before 写真 ＆ 撮影日 %>
      <div class="mt-6 p-4 border border-gray-100 rounded-2xl bg-gray-50/50">
        <%= f.label :before_image, "Before 写真", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <% if @album_record.before_image.attached? %>
          <div class="mb-3">
            <%= image_tag @album_record.before_image, class: "w-20 h-20 object-cover rounded-lg border border-gray-200" %>
          </div>
        <% end %>
        <%= f.file_field :before_image, accept: "image/*", class: "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-500 hover:file:bg-blue-100 cursor-pointer mb-3" %>
        
        <%= f.label :before_date, "Before 撮影日", class: "block text-xs text-gray-500 mb-1" %>
        <%= f.date_field :before_date, class: "w-full border border-gray-200 rounded-xl px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-200" %>
      </div>

      <%# After 写真 ＆ 撮影日 %>
      <div class="mt-6 p-4 border border-gray-100 rounded-2xl bg-gray-50/50">
        <%= f.label :after_image, "After 写真", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <% if @album_record.after_image.attached? %>
          <div class="mb-3">
            <%= image_tag @album_record.after_image, class: "w-20 h-20 object-cover rounded-lg border border-gray-200" %>
          </div>
        <% end %>
        <%= f.file_field :after_image, accept: "image/*", class: "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-500 hover:file:bg-blue-100 cursor-pointer mb-3" %>
        
        <%= f.label :after_date, "After 撮影日", class: "block text-xs text-gray-500 mb-1" %>
        <%= f.date_field :after_date, class: "w-full border border-gray-200 rounded-xl px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-200" %>
      </div>

      <div class="mt-6">
        <%= f.label :memo, "メモ（任意）", class: "block text-sm text-gray-500 mb-2" %>
        <%= f.text_area :memo, rows: 3, class: "w-full border border-gray-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-200" %>
      </div>

      <div class="mt-10">
        <%= f.submit "変更を更新する", class: "w-full bg-blue-500 hover:bg-blue-600 text-white py-3 rounded-full transition duration-300 cursor-pointer" %>
      </div>

    <% end %>

    <%# アルバム編集ページに戻るリンク %>
    <div class="mt-6 text-center">
      <%= link_to "アルバム編集ページに戻る", edit_album_path(@album), class: "text-sm text-gray-400 hover:text-gray-600 hover:underline transition duration-200" %>
    </div>

  </div>
</div>