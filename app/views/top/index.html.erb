<main class="max-w-7xl mx-auto px-6 h-[calc(100vh-64px)] flex flex-col justify-between py-4">

  <section class="flex-1 flex flex-col justify-center items-center gap-6">

    <!-- 上側：メッセージ -->
    <div class="order-1 md:order-1">

      <h2 class="text-center text-4xl md:text-6xl font-serif tracking-wide leading-tight text-blue-400">
        Beauty B/A<br>
      </h2>

      <p class="text-center mt-8 font-sans text-gray-500 leading-8">
        美容施術後のB/Aを<br>
        アルバムとして残そう。
      </p>

    </div>

    <!-- 真ん中：画像 -->
    <div class="order-2 md:order-2 w-full md:w-1/2 h-[400px] md:h-[450px]">

      <div style="background-image: url(<%= asset_path('デフォルメ2.png') %>);" class="rounded-3xl overflow-hidden w-auto h-full bg-cover bg-center">
      </div>

    </div>

    <!-- 下側: 新規登録ボタン -->
    <div class="order-3 md:order-3 text-center">
      <% unless user_signed_in? %>
        <%= link_to new_user_registration_path,
            class: "inline-flex items-center justify-center gap-4 mt-10 bg-blue-500 hover:bg-blue-600 text-white px-10 py-4 rounded-full transition duration-300" do %>

          新規登録
          <span>→</span>
      

        <% end %>
      <% end %>

    </div>

  </section>

</main>

<footer class="text-center py-8 text-sm text-gray-400">
  © Beauty B/A
</footer>